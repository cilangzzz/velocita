{
  "manifest_version": 3,
  "name": "Velocita for Chrome",
  "version": "1.0.0",
  "description": "Send downloads to Velocita download manager.",
  "minimum_chrome_version": "102",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download with Velocita",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
